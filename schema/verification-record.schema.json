{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipelab.org/schemas/ael/v0.1/verification-record.schema.json",
  "title": "AEL verification record manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "package_format", "id", "run", "producer", "operator", "verifier", "verification_custody", "evidence_coverage", "artifact_binding", "files", "verification_inputs", "spec", "checker", "artifact_evaluation", "conformance", "grades", "issued_at", "status_authority"],
  "properties": {
    "kind": { "const": "verification-record" }, "package_format": { "const": 1 }, "id": { "$ref": "#/$defs/nonEmpty" }, "run": { "$ref": "#/$defs/nonEmpty" }, "producer": { "$ref": "#/$defs/party" }, "operator": { "$ref": "#/$defs/party" }, "verifier": { "$ref": "#/$defs/verifier" }, "verification_custody": { "$ref": "#/$defs/custody" }, "evidence_coverage": { "$ref": "#/$defs/coverage" }, "artifact_binding": { "$ref": "#/$defs/artifactBinding" }, "files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/blob" } }, "verification_inputs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/blob" } }, "spec": { "$ref": "#/$defs/versionedDigest" }, "checker": { "$ref": "#/$defs/checker" }, "artifact_evaluation": { "$ref": "#/$defs/evaluation" }, "conformance": { "$ref": "#/$defs/conformance" }, "grades": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/grade" } }, "issued_at": { "$ref": "#/$defs/rfc3339" }, "expires_at": { "$ref": "#/$defs/rfc3339" }, "status_authority": { "$ref": "#/$defs/statusAuthority" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 }, "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!\\.\\.?(/|$))[^/\\\\:\\u0000-\\u001f]+(/(?!\\.\\.?(/|$))[^/\\\\:\\u0000-\\u001f]+)*$" }, "rfc3339": { "type": "string", "format": "date-time" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "party": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "$ref": "#/$defs/nonEmpty" } } },
    "signer": { "type": "object", "additionalProperties": false, "required": ["id", "key"], "properties": { "id": { "$ref": "#/$defs/nonEmpty" }, "key": { "$ref": "#/$defs/sha256" } } },
    "verifier": { "type": "object", "additionalProperties": false, "required": ["id", "key", "relationship_to_producer", "relationship_to_operator"], "properties": { "id": { "$ref": "#/$defs/nonEmpty" }, "key": { "$ref": "#/$defs/sha256" }, "relationship_to_producer": { "$ref": "#/$defs/nonEmpty" }, "relationship_to_operator": { "$ref": "#/$defs/nonEmpty" } } },
    "custody": { "type": "object", "additionalProperties": false, "required": ["acquisition", "replay", "review", "issuance"], "properties": { "acquisition": { "$ref": "#/$defs/nonEmpty" }, "replay": { "$ref": "#/$defs/nonEmpty" }, "review": { "$ref": "#/$defs/nonEmpty" }, "issuance": { "$ref": "#/$defs/nonEmpty" } } },
    "coverage": { "type": "object", "additionalProperties": false, "required": ["scope", "disclosure"], "properties": { "scope": { "$ref": "#/$defs/nonEmpty" }, "disclosure": { "$ref": "#/$defs/nonEmpty" } } },
    "blob": { "type": "object", "additionalProperties": false, "required": ["path", "size", "digest_algorithm", "digest"], "properties": { "path": { "$ref": "#/$defs/relativePath" }, "size": { "type": "integer", "minimum": 0 }, "digest_algorithm": { "const": "sha-256" }, "digest": { "$ref": "#/$defs/sha256" }, "url": { "type": "string", "format": "uri" } } },
    "artifactBinding": { "type": "object", "additionalProperties": false, "required": ["root", "keys_dir", "manifest", "discovered_runs"], "properties": { "root": { "$ref": "#/$defs/relativePath" }, "keys_dir": { "$ref": "#/$defs/relativePath" }, "manifest": { "$ref": "#/$defs/blob" }, "discovered_runs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } } } },
    "versionedDigest": { "type": "object", "additionalProperties": false, "required": ["version", "digest_algorithm", "digest"], "properties": { "version": { "$ref": "#/$defs/nonEmpty" }, "digest_algorithm": { "const": "sha-256" }, "digest": { "$ref": "#/$defs/sha256" } } },
    "checker": { "type": "object", "additionalProperties": false, "required": ["name", "source_revision", "executable"], "properties": { "name": { "$ref": "#/$defs/nonEmpty" }, "source_revision": { "$ref": "#/$defs/nonEmpty" }, "executable": { "$ref": "#/$defs/blob" } } },
    "evaluation": { "type": "object", "additionalProperties": false, "required": ["arguments", "exit_status", "machine_output", "stdout", "stderr"], "properties": { "arguments": { "type": "array", "items": { "type": "string" } }, "exit_status": { "type": "integer", "minimum": 0 }, "machine_output": { "$ref": "#/$defs/blob" }, "stdout": { "$ref": "#/$defs/blob" }, "stderr": { "$ref": "#/$defs/blob" } } },
    "conformance": { "type": "object", "additionalProperties": false, "required": ["corpus", "command", "exit_status", "result"], "properties": { "corpus": { "$ref": "#/$defs/versionedDigest" }, "command": { "type": "array", "items": { "type": "string" } }, "exit_status": { "type": "integer", "minimum": 0 }, "result": { "$ref": "#/$defs/blob" } } },
    "grade": { "type": "object", "additionalProperties": false, "required": ["run", "line", "annotations", "outcomes"], "properties": { "run": { "$ref": "#/$defs/nonEmpty" }, "line": { "$ref": "#/$defs/nonEmpty" }, "annotations": { "type": "object", "additionalProperties": false, "required": ["coverage", "custody", "anchor", "retention"], "properties": { "coverage": { "$ref": "#/$defs/nonEmpty" }, "custody": { "$ref": "#/$defs/nonEmpty" }, "anchor": { "$ref": "#/$defs/nonEmpty" }, "retention": { "$ref": "#/$defs/nonEmpty" } } }, "outcomes": { "type": "object", "minProperties": 1, "additionalProperties": { "enum": ["PASS", "FAIL", "UV"] } } } },
    "statusAuthority": { "type": "object", "additionalProperties": false, "required": ["id", "key", "record_id"], "properties": { "id": { "$ref": "#/$defs/nonEmpty" }, "key": { "$ref": "#/$defs/sha256" }, "record_id": { "$ref": "#/$defs/nonEmpty" }, "url": { "type": "string", "format": "uri" } } }
  }
}
